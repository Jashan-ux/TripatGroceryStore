{
  "components": {
    "schemas": {
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "details": {
            "title": "Details",
            "type": "object"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id"
          }
        },
        "required": ["code", "message"],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorResponse": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "required": ["error"],
        "title": "ErrorResponse",
        "type": "object"
      },
      "HealthComponent": {
        "additionalProperties": false,
        "properties": {
          "latency_ms": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latency Ms"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "status": {
            "enum": ["ok", "degraded", "down", "not_configured"],
            "title": "Status",
            "type": "string"
          }
        },
        "required": ["name", "status"],
        "title": "HealthComponent",
        "type": "object"
      },
      "HealthResponse": {
        "additionalProperties": false,
        "properties": {
          "components": {
            "items": {
              "$ref": "#/components/schemas/HealthComponent"
            },
            "title": "Components",
            "type": "array"
          },
          "environment": {
            "title": "Environment",
            "type": "string"
          },
          "status": {
            "enum": ["ok", "degraded"],
            "title": "Status",
            "type": "string"
          },
          "uptime_seconds": {
            "title": "Uptime Seconds",
            "type": "number"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": ["status", "version", "environment", "uptime_seconds", "components"],
        "title": "HealthResponse",
        "type": "object"
      },
      "PublicConfig": {
        "additionalProperties": false,
        "properties": {
          "environment": {
            "title": "Environment",
            "type": "string"
          },
          "feedback_email": {
            "title": "Feedback Email",
            "type": "string"
          },
          "phone_otp_enabled": {
            "title": "Phone Otp Enabled",
            "type": "boolean"
          },
          "store_address": {
            "title": "Store Address",
            "type": "string"
          },
          "store_maps_url": {
            "default": "",
            "title": "Store Maps Url",
            "type": "string"
          },
          "store_name": {
            "title": "Store Name",
            "type": "string"
          },
          "store_phone": {
            "title": "Store Phone",
            "type": "string"
          },
          "supabase_anon_key": {
            "default": "",
            "title": "Supabase Anon Key",
            "type": "string"
          },
          "supabase_url": {
            "default": "",
            "title": "Supabase Url",
            "type": "string"
          },
          "turnstile_enabled": {
            "title": "Turnstile Enabled",
            "type": "boolean"
          },
          "vapid_public_key": {
            "default": "",
            "title": "Vapid Public Key",
            "type": "string"
          }
        },
        "required": [
          "environment",
          "store_name",
          "store_phone",
          "store_address",
          "feedback_email",
          "phone_otp_enabled",
          "turnstile_enabled"
        ],
        "title": "PublicConfig",
        "type": "object"
      },
      "StatusResponse": {
        "additionalProperties": false,
        "properties": {
          "server_time": {
            "format": "date-time",
            "title": "Server Time",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": ["server_time"],
        "title": "StatusResponse",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "\nREST API for **Tripat Pansari \u00b7 MSG Store** \u2014 Mandi Dabwali, Haryana.\n\n* Money is integer **paise**; timestamps are UTC (displayed in Asia/Kolkata).\n* Every error uses one shape: `{\"error\": {\"code\", \"message\", \"details\", \"request_id\"}}`.\n* Order placement requires an `Idempotency-Key` header.\n",
    "title": "Tripat Pansari \u00b7 MSG Store API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/config": {
      "get": {
        "description": "Non-secret values the frontend needs (store contact, Supabase URL/anon key).\n\nThe anon key is public by design; the service-role key never leaves the server.",
        "operationId": "public_config_api_v1_config_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicConfig"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Missing, expired or invalid token."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Authenticated but not allowed."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Resource not found or not owned by caller."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Validation failed."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Rate limit exceeded."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unexpected server error."
          }
        },
        "summary": "Public runtime configuration",
        "tags": ["system"]
      }
    },
