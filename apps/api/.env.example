# ---------------------------------------------------------------------------
# Backend environment (apps/api). Copy to apps/api/.env for local development.
# NEVER commit real values. Production values live in the host's secret store.
# ---------------------------------------------------------------------------

# local | staging | production | test
ENVIRONMENT=local
LOG_LEVEL=INFO

# Public origin of the web app (CORS allowlist + email links).
WEB_ORIGIN=http://localhost:5173
# Extra allowed origins for previews, comma separated. Never "*".
CORS_EXTRA_ORIGINS=

# --- Database ---------------------------------------------------------------
# Supabase pooler, transaction mode (note the :6543 port and ?pgbouncer=true).
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# Direct connection, used by Alembic only.
DATABASE_DIRECT_URL=postgresql+asyncpg://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# --- Supabase ---------------------------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_AUDIENCE=authenticated
# Optional overrides; derived from SUPABASE_URL when empty.
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET=catalog

# --- Redis (required in production for shared rate limiting) ----------------
REDIS_URL=
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=120/minute

# --- Store contact (seeded into store_settings; not hard-coded in components)
STORE_PHONE=+91 87089-73386
STORE_NAME=Tripat Pansari MSG Store
STORE_ADDRESS=Tripat Pansari MSG Store, near Sabji Mandi, opposite Gyani Achhar Bhandaar, Mandi Dabwali, 125104
# Owner supplies the Google Maps short link.
STORE_MAPS_URL=
FEEDBACK_EMAIL=tripatinsan029@gmail.com
SUPPORT_EMAIL_FROM=Tripat Pansari <orders@your-domain.invalid>

# --- Integrations -----------------------------------------------------------
RESEND_API_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tripatinsan029@gmail.com
TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=
GOOGLE_OAUTH_CLIENT_IDS=
NOMINATIM_USER_AGENT=TripatMSGStore/1.0 (tripatinsan029@gmail.com)

# --- Feature flags ----------------------------------------------------------
PHONE_OTP_ENABLED=false

# --- Bootstrap (admin role granted at seed time only) -----------------------
ADMIN_EMAILS=

# --- Optional observability -------------------------------------------------
SENTRY_DSN=
