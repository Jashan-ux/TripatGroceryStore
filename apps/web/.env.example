# ---------------------------------------------------------------------------
# Frontend build-time environment (apps/web). Copy to apps/web/.env.local.
# Only VITE_* values reach the browser bundle — never put a secret here.
# ---------------------------------------------------------------------------

# Empty = same origin (Vercel/Netlify rewrite /api/* to the backend).
# Set to the HTTPS origin when calling a separately hosted API directly (CORS must allow the site origin).
VITE_API_BASE_URL=

# Where the dev server proxies /api/* during `npm run dev`.
VITE_PROXY_API_ORIGIN=http://127.0.0.1:8000

# Optional public build-time overrides. This Vite app reads the Supabase URL and
# publishable key from GET /api/v1/config in deployed environments, so these can
# stay empty. `vite.config.ts` explicitly exposes only NEXT_PUBLIC_SUPABASE_* from
# the NEXT_PUBLIC namespace; the older VITE_* names remain supported as fallback.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Legacy local names retained for existing .env.local files.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
