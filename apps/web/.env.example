# ---------------------------------------------------------------------------
# Frontend build-time environment (apps/web). Copy to apps/web/.env.local.
# Only VITE_* values reach the browser bundle — never put a secret here.
# ---------------------------------------------------------------------------

# Empty = same origin (Vercel/Netlify rewrite /api/* to the backend).
# Set to the HTTPS origin when calling a separately hosted API directly (CORS must allow the site origin).
VITE_API_BASE_URL=

# Where the dev server proxies /api/* during `npm run dev`.
VITE_PROXY_API_ORIGIN=http://127.0.0.1:8000

# Optional local override. In deployed environments the app reads the Supabase
# URL and anon key from GET /api/v1/config, so no rebuild is needed to change them.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
