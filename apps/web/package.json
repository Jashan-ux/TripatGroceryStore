{
  "name": "@tripat/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Tripat Pansari · MSG Store — customer storefront and admin PWA",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run build --workspace @tripat/api-client",
    "build": "tsc -b && vite build",
    "build:only": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "pretypecheck": "npm run build --workspace @tripat/api-client",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "icons": "node scripts/generate-icons.mjs",
    "lighthouse:ci": "node scripts/run-lighthouse.mjs",
    "size": "node scripts/check-bundle-size.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "7.0.9",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-slot": "1.5.0",
    "@supabase/supabase-js": "2.119.2",
    "@tanstack/react-query": "5.108.4",
    "@tripat/api-client": "*",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.79.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.92.0",
    "react-router-dom": "7.18.7",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.1",
    "workbox-window": "7.4.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@playwright/test": "1.65.1",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "26.6.6",
    "@types/react": "18.3.17",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "autoprefixer": "10.7.0",
    "chrome-launcher": "^1.2.3",
    "eslint": "10.15.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "lighthouse": "^13.6.0",
    "openapi-typescript": "7.13.0",
    "postcss": "8.5.33",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.1"
  }
}
